<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="1124.0" prefWidth="1440.0" style="-fx-background-color: #FFFFFF;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ecommerce.product.ProductListViewController">
    <children>
        <Text layoutX="80.0" layoutY="80.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Everything you need">
            <font>
                <Font name="System Bold" size="42.0"/>
            </font>
        </Text>

        <HBox layoutX="80.0" layoutY="120.0" prefHeight="44.0" spacing="10.0">
            <children>
                <Button mnemonicParsing="false"
                        style="-fx-background-color: #fff; -fx-border-color: #F2F4F8; -fx-border-width: 2; -fx-background-radius: 100; -fx-border-radius: 100;"
                        text="Category" textFill="#4d5358">
                    <font>
                        <Font name="System Bold" size="12.0"/>
                    </font>
                    <padding>
                        <Insets bottom="10.0" left="26.0" right="26.0" top="10.0"/>
                    </padding>
                </Button>
            </children>
        </HBox>

        <GridPane fx:id="gridPane" hgap="45.0" layoutX="80.0" layoutY="208.0" prefHeight="850.0" prefWidth="1140.0"
                  vgap="45.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints maxHeight="400.0" minHeight="10.0" prefHeight="400.0" vgrow="SOMETIMES"/>
                <RowConstraints maxHeight="420.0" minHeight="10.0" prefHeight="400.0" vgrow="SOMETIMES"/>
            </rowConstraints>
        </GridPane>
    </children>
</AnchorPane>
