<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="167.0" prefWidth="1440.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ecommerce.shared.NavbarController">
   <children>
      <!-- TextField Search -->
      <TextField layoutX="120.0" layoutY="95.0" prefHeight="48.0" prefWidth="1030.0" promptText="Search For" style="-fx-background-radius: 25;">
         <padding>
            <Insets bottom="13.0" left="16.0" right="16.0" top="13.0" />
         </padding>
         <font>
            <Font size="16.0" />
         </font>
      </TextField>

      <!-- Cart Button -->
      <Button layoutX="1200.0" layoutY="97.0" mnemonicParsing="false" prefHeight="48.0" prefWidth="48.0" style="-fx-background-radius: 100; -fx-background-color: #f2f4f8;" text="CART">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>

      <!-- Profile Button -->
      <Button layoutX="1272.0" layoutY="97.0" mnemonicParsing="false" prefHeight="48.0" prefWidth="48.0" style="-fx-background-radius: 100; -fx-background-color: #f2f4f8;" text="P" onAction="#toggleProfileBar">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>

      <!-- Title -->
      <Text fill="#697077" layoutX="656.0" layoutY="48.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Toko Kami">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Text>
   </children>
</AnchorPane>
