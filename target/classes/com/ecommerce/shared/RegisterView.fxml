<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Rectangle2D?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ecommerce.shared.RegisterController" style="-fx-background-color: #f7f7f7;">
   <children>
      <!-- Container for the form and image -->
      <HBox alignment="CENTER" spacing="50.0" StackPane.alignment="CENTER">
         <children>
            <!-- Image Section -->
            <ImageView fitHeight="600.0" fitWidth="400.0" pickOnBounds="true" preserveRatio="true" style="-fx-background-radius: 25;">
               <image>
                  <Image url="@../../../images/fuja.png" />
               </image>
               <viewport>
                  <Rectangle2D />
               </viewport>
               <clip>
                  <Rectangle arcHeight="25" arcWidth="25" height="600" width="400" />
               </clip>
            </ImageView>

            <!-- Form Section -->
            <VBox alignment="CENTER" spacing="20.0" prefWidth="400.0">
               <children>
                  <!-- Title and Subtitle -->
                  <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Register">
                     <font>
                        <Font size="36.0" />
                     </font>
                  </Text>
                  <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Please register to login" wrappingWidth="350.0">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Text>

                  <!-- Input Fields -->
                  <VBox spacing="15.0" alignment="CENTER">
                     <children>
                        <TextField fx:id="username" prefHeight="45.0" prefWidth="350.0" promptText="Username" style="-fx-background-radius: 25; -fx-padding: 0 20;">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </TextField>
                        <TextField fx:id="email" prefHeight="45.0" prefWidth="350.0" promptText="Email" style="-fx-background-radius: 25; -fx-padding: 0 20;">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </TextField>
                        <PasswordField fx:id="password" prefHeight="45.0" prefWidth="350.0" promptText="Password" style="-fx-background-radius: 25; -fx-padding: 0 20;">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </PasswordField>
                        <PasswordField fx:id="confirm_password" prefHeight="45.0" prefWidth="350.0" promptText="Confirm Password" style="-fx-background-radius: 25; -fx-padding: 0 20;">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </PasswordField>
                     </children>
                  </VBox>

                  <!-- Buttons and Links -->
                  <VBox spacing="15.0" alignment="CENTER">
                     <children>
                        <Button fx:id="sign_up" mnemonicParsing="false" onAction="#handleRegister" prefHeight="45.0" prefWidth="350.0" style="-fx-background-radius: 25; -fx-background-color: #64DCBF; -fx-text-fill: white;" text="Sign Up">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Button>
                        <Text onMouseClicked="#handleBackToLogin" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-cursor: hand; -fx-text-fill: #007BFF;" text="Already have an account? Login">
                           <font>
                              <Font size="12.0" />
                           </font>
                        </Text>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</StackPane>
