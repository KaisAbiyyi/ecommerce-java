<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
   prefHeight="1024.0" prefWidth="1440.0" xmlns="http://javafx.com/javafx/23.0.1"
   xmlns:fx="http://javafx.com/fxml/1" 
   fx:controller="com.ecommerce.shared.RegisterController">
   <children>
      <BorderPane prefHeight="1024.0" prefWidth="1440.0">
         <left>
            <ImageView fitHeight="1024.0" fitWidth="914.0" pickOnBounds="true" preserveRatio="true"
               BorderPane.alignment="CENTER">
               <image>
                  <Image url="@../../../images/fuja.png" />
               </image>
            </ImageView>
         </left>
         <right>
            <Pane BorderPane.alignment="CENTER">
               <children>
                  <VBox>
                     <children>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Register">
                           <font>
                              <Font size="48.0" />
                           </font>
                        </Text>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Please register to login">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </Text>
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" layoutX="34.0" layoutY="203.0" spacing="20.0">
                     <children>
                        <VBox spacing="50.0">
                           <children>
                              <VBox spacing="20.0">
                                 <children>
                                    <TextField fx:id="username" prefHeight="50.0" prefWidth="400.0"
                                       promptText="Username" style="-fx-background-radius: 25;" />
                                    <TextField fx:id="email" prefHeight="50.0" prefWidth="400.0"
                                       promptText="Email" style="-fx-background-radius: 25;" />
                                    <PasswordField fx:id="password" prefHeight="50.0"
                                       prefWidth="400.0" promptText="Password"
                                       style="-fx-background-radius: 25;" />
                                    <PasswordField fx:id="confirm_password" prefHeight="50.0"
                                       prefWidth="400.0" promptText="Confirm Password"
                                       style="-fx-background-radius: 25;" />
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER" spacing="20.0">
                                 <children>
                                    <Button fx:id="sign_up" mnemonicParsing="false"
                                       prefHeight="50.0" prefWidth="400.0"
                                       style="-fx-background-radius: 25; -fx-background-color: rgba(100, 220, 191, 1);"
                                       text="Sign Up" textFill="WHITE" 
                                       onAction="#handleRegister"/>
                                    <Text strokeType="OUTSIDE" strokeWidth="0.0"
                                       text="Already have an account? Login" 
                                       style="-fx-cursor: hand;" 
                                       onMouseClicked="#handleBackToLogin">
                                       <font>
                                          <Font size="14.0" />
                                       </font>
                                    </Text>
                                 </children>
                              </VBox>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </children>
               <BorderPane.margin>
                  <Insets top="200.0" />
               </BorderPane.margin>
            </Pane>
         </right>
         <padding>
            <Insets right="80.0" />
         </padding>
      </BorderPane>
   </children>
</AnchorPane>
