<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<StackPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ecommerce.content.seller.OrdersController">
    <children>
        <VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-padding: 40; -fx-background-color: white;" StackPane.alignment="CENTER">

            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <Button fx:id="profileButton" style="-fx-border-radius: 25; -fx-background-radius: 25; -fx-font-weight: 900; -fx-background-color: #F5F5F5; -fx-border-color: #C0C0C0; -fx-text-fill: #4A4A4A;" text="Profile">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                    <padding>
                        <Insets bottom="5.0" left="25.0" right="25.0" top="5.0" />
                    </padding>
                </Button>
                <Button fx:id="cartButton" style="-fx-border-radius: 25; -fx-background-radius: 25; -fx-font-weight: 900; -fx-background-color: #F5F5F5; -fx-border-color: #C0C0C0; -fx-text-fill: #4A4A4A;" text="Cart">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                    <padding>
                        <Insets bottom="5.0" left="25.0" right="25.0" top="5.0" />
                    </padding>
                </Button>
                <Button fx:id="checkoutButton" style="-fx-border-radius: 25; -fx-background-radius: 25; -fx-font-weight: 900; -fx-background-color: #F5F5F5; -fx-border-color: #C0C0C0; -fx-text-fill: #4A4A4A;" text="Checkout">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                    <padding>
                        <Insets bottom="5.0" left="25.0" right="25.0" top="5.0" />
                    </padding>
                </Button>
                <Button fx:id="productsButton" style="-fx-border-radius: 25; -fx-background-radius: 25; -fx-font-weight: 900; -fx-background-color: #F5F5F5; -fx-border-color: #C0C0C0; -fx-text-fill: #4A4A4A;" text="Products">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                    <padding>
                        <Insets bottom="5.0" left="25.0" right="25.0" top="5.0" />
                    </padding>
                </Button>
                <Button fx:id="ordersButton" style="-fx-border-radius: 25; -fx-background-radius: 25; -fx-font-weight: 900; -fx-background-color: #F5F5F5; -fx-border-color: #C0C0C0; -fx-text-fill: #4A4A4A;" text="Orders">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                    <padding>
                        <Insets bottom="5.0" left="25.0" right="25.0" top="5.0" />
                    </padding>
                </Button>
            </HBox>
            <!-- Title Section -->
            <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-padding: 10px;">
                <Text style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Order View" />
                <Button fx:id="refreshButton" alignment="CENTER_RIGHT" style="-fx-background-color: #31D0AA; -fx-text-fill: white; -fx-font-weight: 900; -fx-background-radius: 25;" text="Refresh">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                    <padding>
                        <Insets bottom="10.0" left="30.0" right="30.0" top="10.0" />
                    </padding>
                </Button>
            </HBox>

            <!-- Scrollable Order Container -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-padding: 10;" vbarPolicy="ALWAYS">
                <VBox fx:id="orderContainer" spacing="10.0" style="-fx-padding: 10;">
                    <!-- Order cards will be dynamically added here -->
                </VBox>
            </ScrollPane>

        </VBox>
    </children>
</StackPane>
