<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<StackPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ecommerce.content.customer.CartController">
    <children>
        <VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-padding: 20;" StackPane.alignment="CENTER">

            <!-- Navigation Bar -->
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 10px;">
                <Button fx:id="profileButton" style="-fx-background-color: white; -fx-text-fill: #31D0AA; -fx-border-color: #31D0AA; -fx-border-width: 2; -fx-border-radius: 25 0 0 25; -fx-background-radius: 25 0 0 25; -fx-font-weight: 900;" text="Profile">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                    <padding>
                        <Insets bottom="10.0" left="30.0" right="30.0" top="10.0" />
                    </padding>
                </Button>
                <Button fx:id="ordersButton" style="-fx-background-color: white; -fx-text-fill: #31D0AA; -fx-border-color: #31D0AA; -fx-background-radius: 0 0 0 0; -fx-border-radius: 0 0 0 0; -fx-border-width: 2 0 2 0; -fx-font-weight: 900;" text="Orders">
                    <padding>
                        <Insets bottom="10.0" left="30.0" right="30.0" top="10.0" />
                    </padding>
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Button>
                <Button fx:id="cartButton" style="-fx-background-color: white; -fx-text-fill: #31D0AA; -fx-border-color: #31D0AA; -fx-border-width: 2; -fx-background-radius: 0 25 25 0; -fx-border-radius: 0 25 25 0; -fx-font-weight: 900;" text="Cart">
                    <padding>
                        <Insets bottom="10.0" left="30.0" right="30.0" top="10.0" />
                    </padding>
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Button>
            </HBox>

            <!-- Title Section -->
            <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-padding: 10px;">
                <Text style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Shopping Cart" />
                <Button fx:id="refreshButton" alignment="CENTER_RIGHT" style="-fx-background-color: #31D0AA; -fx-text-fill: white; -fx-font-weight: 900; -fx-background-radius: 25;" text="Refresh">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                    <padding>
                        <Insets bottom="10.0" left="30.0" right="30.0" top="10.0" />
                    </padding>
                </Button>
            </HBox>

            <!-- Scrollable Cart Items Container -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="ALWAYS" style="-fx-padding: 10;">
                <VBox fx:id="cartItemsContainer" spacing="10.0" style="-fx-padding: 10;">
                    <!-- Cart items will be dynamically added here -->
                </VBox>
            </ScrollPane>

            <!-- Checkout Section -->
            <HBox alignment="CENTER_RIGHT" spacing="20.0" style="-fx-padding: 10px;">
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Total Price:" />
                <Label fx:id="totalPriceLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #64DCBF;" text="Rp0.00" />
                <Button fx:id="checkoutButton" text="Checkout" style="-fx-background-color: #31D0AA; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 25;" />
            </HBox>

        </VBox>
    </children>
</StackPane>
