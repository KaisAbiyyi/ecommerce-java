<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<HBox prefHeight="600.0" prefWidth="800.0" spacing="30" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ecommerce.customer.CartController">
    <children>
        <!-- Product List Section -->
        <VBox spacing="20" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-border-radius: 15; -fx-border-color: lightgray; -fx-border-width: 1; -fx-pref-width: 500;">
            <children>
                <Label alignment="CENTER" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Shopping Cart" />
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                    <content>
                        <VBox fx:id="cartItemsContainer" spacing="10" />
                    </content>
                </ScrollPane>
            </children>
        </VBox>

        <!-- Checkout Section -->
        <VBox spacing="20" style="-fx-background-color: #ffffff; -fx-padding: 30; -fx-border-radius: 15; -fx-border-color: lightgray; -fx-border-width: 1; -fx-pref-width: 250;">
            <children>
                <Label style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Checkout" />
                <HBox spacing="10" alignment="CENTER">
                    <Label style="-fx-font-size: 16px; -fx-text-fill: #333333;" text="Total:" />
                    <Label fx:id="totalPriceLabel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #64DCBF;" text="Rp0.00" />
                </HBox>
                <Button fx:id="checkoutButton" text="Checkout" style="-fx-background-color: #64DCBF; -fx-text-fill: white; -fx-font-size: 18px; -fx-background-radius: 25;" />
            </children>
        </VBox>
    </children>
</HBox>
