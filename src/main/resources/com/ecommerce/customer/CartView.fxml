<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="600.0" prefWidth="800.0" spacing="30" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <!-- Product List Section -->
        <VBox fx:id="productList" spacing="20" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-border-radius: 15; -fx-border-color: lightgray; -fx-border-width: 1; -fx-pref-width: 500;">
            <!-- Header Section -->
            <Label alignment="CENTER" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Shopping Cart" />

            <!-- Product Card Example -->
            <StackPane style="-fx-border-color: lightgray; -fx-border-width: 1; -fx-border-radius: 15; -fx-background-color: #ffffff; -fx-background-radius: 15; -fx-padding: 20; -fx-pref-height: 150;">
                <children>
                    <!-- Content of Product Card -->
                    <HBox spacing="20" alignment="CENTER">
                        <!-- Product Image -->
                        <ImageView fx:id="productImage" fitHeight="120" fitWidth="120" />

                        <!-- Product Details -->
                        <VBox spacing="10" alignment="CENTER">
                            <Label fx:id="productName" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Product Name" />
                            <Label fx:id="productRef" style="-fx-font-size: 14; -fx-text-fill: gray;" text="Deskripsi produk" />

                            <!-- Quantity and Price -->
                            <VBox alignment="CENTER" spacing="10">
                                <HBox spacing="10" alignment="CENTER">
                                    <Button fx:id="decreaseQuantityButton" text="-" style="-fx-background-color: #64DCBF; -fx-text-fill: white; -fx-font-size: 18px; -fx-background-radius: 50%; -fx-min-width: 40; -fx-min-height: 40;" />
                                    <TextField fx:id="quantityField" text="1" style="-fx-pref-width: 60; -fx-text-alignment: center; -fx-font-size: 16px; -fx-border-color: lightgray; -fx-border-width: 1; -fx-background-color: white; -fx-background-radius: 5;" />
                                    <Button fx:id="increaseQuantityButton" text="+" style="-fx-background-color: #64DCBF; -fx-text-fill: white; -fx-font-size: 18px; -fx-background-radius: 50%; -fx-min-width: 40; -fx-min-height: 40;" />
                                </HBox>
                                <Label fx:id="productPrice" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #64DCBF;" text="Rp0.00" />
                            </VBox>
                        </VBox>
                    </HBox>

                    <!-- Remove Button -->
                    <Button fx:id="removeProductButton" text="X" style="-fx-background-color: transparent; -fx-text-fill: red; -fx-font-size: 16px; -fx-cursor: pointer;" StackPane.alignment="TOP_RIGHT" />
                </children>
            </StackPane>
        </VBox>

        <!-- Checkout Section -->
        <VBox spacing="20" style="-fx-background-color: #ffffff; -fx-padding: 30; -fx-border-radius: 15; -fx-border-color: lightgray; -fx-border-width: 1; -fx-pref-width: 250;">
            <children>
                <Label style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Checkout" />
                <HBox alignment="CENTER" spacing="10">
                    <Label style="-fx-font-size: 16; -fx-text-fill: #333333;" text="Total:" />
                    <Label fx:id="totalPriceLabel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Rp0.00" />
                </HBox>
                <Button fx:id="checkoutButton" text="Checkout" style="-fx-background-color: #64DCBF; -fx-text-fill: white; -fx-font-size: 18px; -fx-background-radius: 25;" />
            </children>
        </VBox>
    </children>
</HBox>
