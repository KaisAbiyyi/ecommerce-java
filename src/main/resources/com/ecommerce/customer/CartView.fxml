<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ecommerce.customer.CartController" spacing="20" alignment="CENTER" style="-fx-padding: 20;">
    <!-- Daftar Item -->
    <ListView fx:id="cartList" prefHeight="400" prefWidth="600" />

    <!-- Total Harga dan Checkout -->
    <HBox spacing="20" alignment="CENTER">
        <Label text="Total: " />
        <Label fx:id="totalPriceLabel" text="Rp0.00" style="-fx-font-weight: bold;" />
        <Button text="Checkout" fx:id="checkoutButton" />
    </HBox>

    <!-- Tombol Kembali -->
    <Button text="Kembali ke Dashboard" fx:id="backButton" />
</VBox>
