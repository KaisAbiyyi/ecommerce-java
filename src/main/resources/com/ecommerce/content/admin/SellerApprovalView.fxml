<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<StackPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ecommerce.content.admin.SellerApprovalController">
    <children>
        <VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-padding: 20;" StackPane.alignment="CENTER">

            <!-- Title Section -->
            <Text text="Seller Approval Requests" style="-fx-font-size: 24px; -fx-font-weight: bold;">
                <font>
                    <Font name="System Bold" size="24.0" />
                </font>
            </Text>

            <!-- Scrollable Request Container -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-padding: 10;" vbarPolicy="ALWAYS">
                <VBox fx:id="requestContainer" prefWidth="700.0" spacing="10.0" style="-fx-padding: 10;">
                    <!-- Data akan diisi dari Controller -->
                </VBox>
            </ScrollPane>

        </VBox>
    </children>
</StackPane>
