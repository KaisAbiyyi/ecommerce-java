<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane alignment="TOP_LEFT" style="-fx-padding: 40; -fx-background-color: white;"
           xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.ecommerce.content.customer.CheckoutController">
    <children>
        <VBox spacing="20" style="-fx-background-color: white;">
            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <Button fx:id="profileButton"
                        style="-fx-border-radius: 25; -fx-background-radius: 25; -fx-font-weight: 900; -fx-background-color: #F5F5F5; -fx-border-color: #C0C0C0; -fx-text-fill: #4A4A4A;"
                        text="Profile">
                    <font>
                        <Font name="System Bold" size="16.0"/>
                    </font>
                    <padding>
                        <Insets bottom="5.0" left="25.0" right="25.0" top="5.0"/>
                    </padding>
                </Button>
                <Button fx:id="cartButton"
                        style="-fx-border-radius: 25; -fx-background-radius: 25; -fx-font-weight: 900; -fx-background-color: #F5F5F5; -fx-border-color: #C0C0C0; -fx-text-fill: #4A4A4A;"
                        text="Cart">
                    <font>
                        <Font name="System Bold" size="16.0"/>
                    </font>
                    <padding>
                        <Insets bottom="5.0" left="25.0" right="25.0" top="5.0"/>
                    </padding>
                </Button>
                <Button fx:id="checkoutButton"
                        style="-fx-border-radius: 25; -fx-background-radius: 25; -fx-font-weight: 900; -fx-background-color: #F5F5F5; -fx-border-color: #C0C0C0; -fx-text-fill: #4A4A4A;"
                        text="Checkout">
                    <font>
                        <Font name="System Bold" size="16.0"/>
                    </font>
                    <padding>
                        <Insets bottom="5.0" left="25.0" right="25.0" top="5.0"/>
                    </padding>
                </Button>
                <Button fx:id="productsButton"
                        style="-fx-border-radius: 25; -fx-background-radius: 25; -fx-font-weight: 900; -fx-background-color: #F5F5F5; -fx-border-color: #C0C0C0; -fx-text-fill: #4A4A4A;"
                        text="Products">
                    <font>
                        <Font name="System Bold" size="16.0"/>
                    </font>
                    <padding>
                        <Insets bottom="5.0" left="25.0" right="25.0" top="5.0"/>
                    </padding>
                </Button>
                <Button fx:id="ordersButton"
                        style="-fx-border-radius: 25; -fx-background-radius: 25; -fx-font-weight: 900; -fx-background-color: #F5F5F5; -fx-border-color: #C0C0C0; -fx-text-fill: #4A4A4A;"
                        text="Orders">
                    <font>
                        <Font name="System Bold" size="16.0"/>
                    </font>
                    <padding>
                        <Insets bottom="5.0" left="25.0" right="25.0" top="5.0"/>
                    </padding>
                </Button>
            </HBox>
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Checkout Overview"/>

            <!-- Order Details (Wrapped in ScrollPane) -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
                <content>
                    <VBox fx:id="orderDetailsContainer" spacing="10"/>
                </content>
            </ScrollPane>

            <!-- Total Price -->
            <Label fx:id="totalPriceLabel" style="-fx-font-size: 16px;" text="Total: Rp0.00"/>

            <!-- File Input for Proof of Payment -->
            <VBox alignment="CENTER_LEFT" spacing="10" fx:id="fileUploadContainer">
                <Label style="-fx-font-size: 14px;" text="Upload Proof of Payment:"/>
                <Button fx:id="uploadProofButton" onAction="#handleFileUpload"
                        style="-fx-background-color: #64B5F6; -fx-text-fill: white;" text="Upload File"/>
                <Label fx:id="fileNameLabel" style="-fx-font-size: 12px;" text="No file selected"/>
            </VBox>

            <!-- Confirm Button -->
            <Button fx:id="confirmPaymentButton" style="-fx-background-color: #31D0AA; -fx-text-fill: white;"
                    text="Confirm Payment"/>
        </VBox>
    </children>
</StackPane>
