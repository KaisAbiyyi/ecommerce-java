<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<StackPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ecommerce.content.seller.ManageProductsController">
    <children>
        <VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-padding: 20;" StackPane.alignment="CENTER"> <!-- Padding untuk semua sisi -->

            <!-- Navigation Bar -->
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 10px;">
                <Button fx:id="profileButton" style="-fx-background-color: white; -fx-text-fill: #31D0AA; -fx-border-color: #31D0AA; -fx-border-width: 2; -fx-border-radius: 25 0 0 25; -fx-background-radius: 25 0 0 25; -fx-font-weight: 900;" text="Profile">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                    <padding>
                        <Insets bottom="10.0" left="30.0" right="30.0" top="10.0" />
                    </padding></Button>
                <Button fx:id="productsButton" style="-fx-background-color: white; -fx-text-fill: #31D0AA; -fx-border-color: #31D0AA; -fx-background-radius: 0 0 0 0; -fx-border-radius: 0 0 0 0; -fx-border-width: 2 0 2 0; -fx-font-weight: 900;" text="Products">
                    <padding>
                        <Insets bottom="10.0" left="30.0" right="30.0" top="10.0" />
                    </padding>
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font></Button>
                <Button fx:id="ordersButton" style="-fx-background-color: white; -fx-text-fill: #31D0AA; -fx-border-color: #31D0AA; -fx-border-width: 2; -fx-background-radius: 0 25 25 0; -fx-border-radius: 0 25 25 0; -fx-font-weight: 900;" text="Orders">
                    <padding>
                        <Insets bottom="10.0" left="30.0" right="30.0" top="10.0" />
                    </padding>
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font></Button>
            </HBox>

            <!-- Title Section -->
            <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-padding: 10px;">
                <Text style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Manage Products" />
                <Button fx:id="addButton" alignment="CENTER_RIGHT" style="-fx-background-color: #31D0AA; -fx-text-fill: white; -fx-font-weight: 900; -fx-background-radius: 25;" text="Add Product">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
               <padding>
                  <Insets bottom="10.0" left="30.0" right="30.0" top="10.0" />
               </padding></Button>
            </HBox>

            <!-- Scrollable Product Container -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-padding: 10;" vbarPolicy="ALWAYS">
                <VBox fx:id="productContainer" prefWidth="700.0" spacing="10.0" style="-fx-padding: 10;">
                    <!-- Data akan diisi dari Controller -->
                </VBox>
            </ScrollPane>

        </VBox>
    </children>
</StackPane>
