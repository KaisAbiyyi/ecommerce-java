<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="167.0" prefWidth="1440.0" style="-fx-background-color: white;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ecommerce.layouts.NavbarController">
    <children>
        <!-- Back Button -->
        <Button layoutX="20.0" layoutY="97.0" mnemonicParsing="false" prefHeight="48.0" prefWidth="48.0"
                style="-fx-background-radius: 100; -fx-background-color: #FF5733; -fx-text-fill: white;" text="←"
                onAction="#goBack">
            <font>
                <Font name="System Bold" size="16.0"/>
            </font>
        </Button>

        <!-- Forward Button -->
        <Button layoutX="88.0" layoutY="97.0" mnemonicParsing="false" prefHeight="48.0" prefWidth="48.0"
                style="-fx-background-radius: 100; -fx-background-color: #33C4FF; -fx-text-fill: white;" text="→"
                onAction="#goForward">
            <font>
                <Font name="System Bold" size="16.0"/>
            </font>
        </Button>

        <!-- TextField Search -->
        <TextField layoutX="160.0" layoutY="95.0" prefHeight="48.0" prefWidth="1030.0" promptText="Search For"
                   style="-fx-background-radius: 25;">
            <padding>
                <Insets bottom="13.0" left="16.0" right="16.0" top="13.0"/>
            </padding>
            <font>
                <Font size="16.0"/>
            </font>
        </TextField>

        <!-- Logout Button -->
        <Button layoutX="1272.0" layoutY="97.0" mnemonicParsing="false" prefHeight="48.0" prefWidth="96.0"
                style="-fx-background-radius: 25; -fx-background-color: #FF6666; -fx-text-fill: white;" text="Logout"
                onAction="#handleLogout">
            <font>
                <Font name="System Bold" size="16.0"/>
            </font>
        </Button>

        <!-- Title -->
        <Text fill="#697077" layoutX="656.0" layoutY="48.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Toko Kami">
            <font>
                <Font name="System Bold" size="24.0"/>
            </font>
        </Text>
    </children>
</AnchorPane>
