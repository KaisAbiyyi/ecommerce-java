<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefWidth="1440.0" style="-fx-background-color: #D9D9D9;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ecommerce.layouts.NavbarController">
    <children>
         <HBox fx:id="navigationSection" alignment="CENTER_LEFT" layoutX="29.0" layoutY="29.0" prefWidth="218.0" spacing="20">
         <children>
                <HBox prefHeight="0.0" prefWidth="219.0">
                    <children>
                        <!-- Home Button -->
                        <Button mnemonicParsing="false" onAction="#goHome" prefHeight="50.0" prefWidth="127.0" style="-fx-background-color: lightgray; -fx-text-fill: #21272A; -fx-font-weight: 900;" text="HOME">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                            <padding>
                                <Insets bottom="10.0" left="30.0" right="30.0" top="10.0" />
                            </padding>
                        </Button>
      
                              <!-- Back Button -->
                        <Button mnemonicParsing="false" onAction="#goBack" prefHeight="50.0" prefWidth="64.0" rotate="180.0" style="-fx-background-color: D9D9D9; -fx-text-fill: #21272A;" text="➜">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Button>
      
                              <!-- Forward Button -->
                        <Button mnemonicParsing="false" onAction="#goForward" prefHeight="50.0" prefWidth="50.0" style="-fx-background-color: D9D9D9; -fx-text-fill: #21272A;" text="➜">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                            <padding>
                                <Insets left="10.0" right="10.0" />
                            </padding>
                        </Button>
                    </children>
                </HBox>
         </children>
         </HBox> <!-- Mengurangi jarak antar elemen -->

        <!-- Navigation Section -->
        <HBox alignment="CENTER" layoutX="1202.0" layoutY="22.0" spacing="20">

            <!-- Role Button (Products/Profile) -->
            <Button fx:id="profileButton" prefHeight="50.0" prefWidth="96.0" style="-fx-background-radius: 25; -fx-background-color: #31D0AA; -fx-text-fill: white; -fx-font-weight: 900;" text="Profile">
                <font>
                    <Font name="System Bold" size="16.0" />
                </font>
            </Button>

            <!-- Auth Button (Login/Logout) -->
            <Button fx:id="authButton" mnemonicParsing="false" prefHeight="50.0" prefWidth="96.0" style="-fx-background-radius: 25; -fx-background-color: #FF6666; -fx-text-fill: white; -fx-font-weight: 900;" text="Logout">
                <font>
                    <Font name="System Bold" size="16.0" />
                </font>
            </Button>
        </HBox>
        <!-- Title Section -->
        <Text fill="#21272a" layoutX="640.0" layoutY="64.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Toko Kami">
            <font>
                <Font name="System Bold" size="32.0" />
            </font>
        </Text>
    </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</AnchorPane>
