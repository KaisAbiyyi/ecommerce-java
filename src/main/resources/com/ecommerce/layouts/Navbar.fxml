<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" prefHeight="200.0" prefWidth="1440.0" spacing="10" style="-fx-background-color: white;"
      xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ecommerce.layouts.NavbarController">
    <children>
        <!-- Title Section -->
        <Text fill="#697077" strokeType="OUTSIDE" strokeWidth="0.0" text="Toko Kami">
            <font>
                <Font name="System Bold" size="32.0"/>
            </font>
        </Text>

        <!-- Gap Between Title and Navigation -->
        <HBox prefHeight="10.0"/> <!-- Mengurangi jarak antar elemen -->

        <!-- Navigation Section -->
        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 0 20;">
            <HBox alignment="CENTER" spacing="20" style="-fx-padding: 0 20;" fx:id="navigationSection">
                <HBox prefHeight="51.0" prefWidth="219.0">
                    <children>
                        <!-- Home Button -->
                        <Button mnemonicParsing="false" onAction="#goHome" prefHeight="50.0" prefWidth="127.0"
                                style="-fx-background-radius: 25 0 0 25; -fx-background-color: white; -fx-text-fill: #31D0AA; -fx-border-color: #31D0AA; -fx-border-width: 2 0 2 2; -fx-border-radius: 25 0 0 25; -fx-font-weight: 900;"
                                text="Home">
                            <font>
                                <Font name="System Bold" size="16.0"/>
                            </font>
                            <padding>
                                <Insets bottom="10.0" left="30.0" right="30.0" top="10.0"/>
                            </padding>
                        </Button>

                        <!-- Back Button -->
                        <Button mnemonicParsing="false" onAction="#goBack" prefHeight="50.0" prefWidth="64.0"
                                style="-fx-background-radius: 100; -fx-background-color: white; -fx-text-fill: #31D0AA; -fx-border-color: #31D0AA; -fx-border-width: 2; -fx-font-weight: 900;"
                                text="←">
                            <font>
                                <Font name="System Bold" size="16.0"/>
                            </font>
                        </Button>

                        <!-- Forward Button -->
                        <Button mnemonicParsing="false" onAction="#goForward" prefHeight="50.0" prefWidth="50.0"
                                style="-fx-background-radius: 0 25 25 0; -fx-background-color: white; -fx-text-fill: #31D0AA; -fx-border-color: #31D0AA; -fx-border-width: 2 2 2 0; -fx-border-radius: 0 25 25 0; -fx-font-weight: 900;"
                                text="→">
                            <font>
                                <Font name="System Bold" size="16.0"/>
                            </font>
                            <padding>
                                <Insets left="10.0" right="10.0"/>
                            </padding>
                        </Button>
                    </children>
                </HBox>
            </HBox>

            <!-- Role Button (Products/Profile) -->
            <Button fx:id="roleButton" mnemonicParsing="false" prefHeight="48.0" prefWidth="96.0"
                    style="-fx-background-radius: 25; -fx-background-color: #31D0AA; -fx-text-fill: white; -fx-font-weight: 900;">
                <font>
                    <Font name="System Bold" size="16.0"/>
                </font>
            </Button>

            <!-- Auth Button (Login/Logout) -->
            <Button fx:id="authButton" mnemonicParsing="false" prefHeight="48.0" prefWidth="96.0"
                    style="-fx-background-radius: 25; -fx-background-color: #FF6666; -fx-text-fill: white; -fx-font-weight: 900;"
                    text="Logout">
                <font>
                    <Font name="System Bold" size="16.0"/>
                </font>
            </Button>
        </HBox>
    </children>
</VBox>
