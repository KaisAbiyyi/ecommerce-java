<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<StackPane fx:id="profileBar" managed="false" visible="false" xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ecommerce.shared.ProfileBarController">
    <AnchorPane prefHeight="1024.0" prefWidth="350.0" style="-fx-background-color: white; -fx-background-radius: 10;">
        <children>
            <Button onAction="#closeProfileBar" text="X" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0"/>
            <Button onAction="#handleLogout" text="Logout" AnchorPane.bottomAnchor="30.0"
                    AnchorPane.leftAnchor="35.0" AnchorPane.rightAnchor="35.0"/>
            <Text fx:id="profileNameText" text="Profile Name" AnchorPane.leftAnchor="35.0"
                  AnchorPane.topAnchor="95.0">
                <font>
                    <Font name="System Bold" size="24.0"/>
                </font>
            </Text>

        </children>
    </AnchorPane>
</StackPane>


