<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="profileBar" managed="false" visible="false" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ecommerce.shared.ProfileBarController">

    <!-- ProfileBar Content -->
    <AnchorPane prefHeight="1024.0" prefWidth="350.0" style="-fx-background-color: white; -fx-background-radius: 10;">
        <children>
            <!-- Tombol Close -->
            <Button onAction="#closeProfileBar" prefHeight="45.0" prefWidth="45.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #d4d4d4; -fx-border-width: 2; -fx-text-fill: #000000;" text="X" textFill="#404040" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
                <font>
                    <Font size="16.0" />
                </font>
            </Button>
            <!-- Tombol Logout -->
            <Button onAction="#handleLogout" prefHeight="50.0" prefWidth="280.0" style="-fx-background-color: #32d0aa; -fx-background-radius: 20; -fx-border-radius: 20; -fx-text-fill: #000000;" text="Logout" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="35.0" AnchorPane.rightAnchor="35.0">
                <font>
                    <Font name="System Bold" size="16.0" />
                </font>
            </Button>
        </children>
        <effect>
            <DropShadow color="#00000055" offsetX="0" offsetY="4" radius="10" />
        </effect>
    </AnchorPane>
</StackPane>
